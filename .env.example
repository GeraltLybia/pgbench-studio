# Ключ шифрования паролей профилей: `studio gen-key` (или `uv run studio gen-key` в backend/)
PGB_STUDIO_SECRET_KEY=
# Первый администратор, создаётся при старте, если пользователей нет
PGB_STUDIO_ADMIN_USER=admin
PGB_STUDIO_ADMIN_PASSWORD=

# Адреса балансировщика через запятую — те же, что server.trusted_proxies в config.yaml
TRUSTED_PROXIES=
# Порт фронтенда на машине агента
FRONTEND_PORT=8080
# Пароль пользователя bench в тестовых базах pg13 и pg18
PGB_TEST_DB_PASSWORD=bench
